{
  "manifest_version": 3,
  "name": "BrowserChatBridge",
  "version": "0.2.0",
  "description": "Lets the BrowserChatBridge Claude Code plugin drive your signed-in ChatGPT and Gemini tabs. Talks only to 127.0.0.1.",
  "permissions": ["scripting", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BrowserChatBridge",
    "default_popup": "popup.html"
  }
}
